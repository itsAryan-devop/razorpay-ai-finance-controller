# Copy this file to `.env` and fill in your Razorpay TEST-MODE keys.
# .env is gitignored — your real keys never get committed and Claude never reads them.
#
# Get test keys: Razorpay Dashboard → (top toggle) Test Mode → Settings → API Keys → Generate Test Key
# Test keys start with rzp_test_ . NEVER put live keys (rzp_live_) here.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# LLM exception handler — ALL OPTIONAL. With none of these set, the pipeline uses
# the deterministic heuristic (zero-config default; this is what CI runs).
#
# Provider selection:
#   LLM_PROVIDER=auto        # default: local Ollama if running, else Anthropic if a
#                            # key is set, else heuristic
#   LLM_PROVIDER=ollama      # force the free local model
#   LLM_PROVIDER=anthropic   # force the paid API
#   LLM_PROVIDER=heuristic   # force the deterministic fallback (fastest, no network)
#
# FREE local model via Ollama (no key, no quota). Default model qwen3:4b fits a 4GB GPU.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b       # alternatives for 4GB VRAM: phi4-mini, qwen3.5:2b
#
# Paid API (optional):
# ANTHROPIC_API_KEY=sk-ant-xxxx
# LLM_MODEL=claude-haiku-4-5-20251001
